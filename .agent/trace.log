     1	class PostTransaction
     2	  def self.call(account, attributes)
     3	    amount = UsdAmount.parse(attributes[:amount])
     4	
     5	    # with_lock starts a database transaction and reloads the account with a
     6	    # PostgreSQL row lock. Other Puma workers and Rails processes must wait
     7	    # for it too. A Ruby Mutex only coordinates threads in the same process.
     8	    # requires_new also gives this operation its own savepoint if the caller
     9	    # already has a transaction open, so a rescued failure rolls back both writes.
    10	    account.with_lock(requires_new: true) do
    11	      transaction = account.transactions.create!(
    12	        direction: attributes[:direction], amount: amount, description: attributes[:description]
    13	      )
    14	      new_balance = transaction.direction == "credit" ? account.balance + amount : account.balance - amount
    15	      account.update!(balance: new_balance)
    16	      transaction
    17	    end
    18	  end
    19	end
