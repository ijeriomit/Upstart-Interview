#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

mkdir -p .agent
touch .agent/trace.log
exec > >(tee -a .agent/trace.log) 2>&1

echo "Starting backend (Docker + Rails)..."

echo "== Docker compose up db =="
docker compose up -d --wait db

echo "== Docker compose ps =="
docker compose ps

echo "== Docker compose db logs (tail) =="
docker compose logs --tail 30 db || true

cd backend

echo "== bundle install =="
bundle install

echo "== rails db:prepare =="
bin/rails db:prepare

echo "== rails db:seed =="
bin/rails db:seed

echo "== rails server =="
echo "Rails API: http://localhost:3000"
bin/rails server -b localhost
import { defineConfig } from 'vite';
import { extensions, classicEmberSupport, ember } from '@embroider/vite';
import { babel } from '@rollup/plugin-babel';

export default defineConfig({
  server: {
    port: 4200,
    // Ember can use same-origin /api URLs during development. Vite forwards
    // the requests to Rails, so there is no browser CORS setup to maintain.
    proxy: {
      '/api': 'http://127.0.0.1:3000',
    },
  },
  plugins: [
    classicEmberSupport(),
    ember(),
    // extra plugins here
    babel({
      babelHelpers: 'runtime',
      extensions,
    }),
  ],
});
