     6	  def self.parse(text)
     7	    # Validate before Active Record casts the value. This rejects numbers sent
     8	    # as JSON floats and extra decimal places that PostgreSQL would round.
     9	    unless text.is_a?(String) && /\A[0-9]{1,17}(?:\.[0-9]{1,2})?\z/.match?(text)
    10	      raise Invalid, "Enter a decimal amount with up to 17 whole digits and two decimal places."
    11	    end
    12	
    13	    BigDecimal(text)
    14	  end
    15	
    16	  # A JSON string carries every digit. Formatting via to_f could lose cents
    17	  # at large balances. SUM also returns an exact decimal from PostgreSQL.
    18	  def self.as_json_string(decimal)
    19	    whole, cents = decimal.to_s("F").split(".", 2)
    20	    "#{whole}.#{cents.to_s.ljust(2, "0")}"
    21	  end
    22	end
