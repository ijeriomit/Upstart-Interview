     6	export default class TransactionForm extends Component {
     7	  // Writing to tracked fields rerenders the parts of the template that use them.
     8	  @tracked isSaving = false;
     9	  @tracked error = '';
    10	  @tracked success = '';
    11	
    12	  @action
    13	  async submit(event) {
    14	    event.preventDefault();
    15	    if (this.isSaving) return;
    16	
    17	    // FormData captures the current input values as strings. A text input
    18	    // with inputmode="decimal" gives mobile users the appropriate keyboard.
    19	    const form = event.currentTarget;
    20	    const data = new FormData(form);
    21	    this.isSaving = true;
    22	    this.error = '';
    23	    this.success = '';
    24	
    25	    try {
    26	      await this.args.onSubmit({
    27	        direction: data.get('direction'),
    28	        amount: data.get('amount').trim(),
    29	        description: data.get('description').trim(),
    30	      });
    31	      form.reset();
    32	      this.success = 'Transaction recorded.';
    33	    } catch (error) {
    34	      this.error = error.message;
    35	    } finally {
    36	      this.isSaving = false;
    37	    }
    38	  }
    39	
    40	  <template>
    41	    <form class="accounts-dashboard-form" {{on "submit" this.submit}}>
    42	      <fieldset disabled={{this.isSaving}}>
    43	        <label>
    44	          Type
    45	          <select name="direction">
    46	            <option value="credit">Credit</option>
    47	            <option value="debit">Debit</option>
    48	          </select>
    49	        </label>
    50	        <label>
    51	          Amount in USD
    52	          <input
    53	            name="amount"
    54	            inputmode="decimal"
    55	            placeholder="0.00"
    56	            maxlength="20"
    57	            required
    58	          />
    59	        </label>
    60	        <label>
    61	          Description
    62	          <span class="accounts-dashboard-optional">(optional)</span>
    63	          <input name="description" maxlength="120" />
    64	        </label>
    65	        <button class="accounts-dashboard-button" type="submit">
    66	          {{if this.isSaving "Recording…" "Record transaction"}}
    67	        </button>
    68	      </fieldset>
    69	      {{#if this.error}}
    70	        <p
    71	          role="alert"
    72	          class="accounts-dashboard-feedback accounts-dashboard-error"
    73	        >{{this.error}}</p>
    74	      {{/if}}
    75	      {{#if this.success}}
    76	        <p
    77	          role="status"
    78	          class="accounts-dashboard-feedback"
    79	        >{{this.success}}</p>
    80	      {{/if}}
    81	    </form>
    82	  </template>
    83	}
