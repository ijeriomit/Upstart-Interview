     2	  def self.call(account, transactions)
     3	    # Writers lock this same row before posting. A shared lock keeps the balance,
     4	    # totals, and history from straddling two different commits.
     5	    account.with_lock("FOR SHARE") do
     6	      totals = transactions.group(:direction).sum(:amount)
     7	      zero = BigDecimal("0")
     8	
     9	      {
    10	        account: AccountJson.call(account),
    11	        totalCredits: UsdAmount.as_json_string(totals.fetch("credit", zero)),
    12	        totalDebits: UsdAmount.as_json_string(totals.fetch("debit", zero)),
    13	        transactions: transactions.order(created_at: :desc, id: :desc).map do |entry|
    14	          {
    15	            id: entry.id.to_s,
    16	            direction: entry.direction,
    17	            amount: UsdAmount.as_json_string(entry.amount),
    18	            description: entry.description,
    19	            createdAt: entry.created_at.iso8601
    20	          }
    21	        end
    22	      }
    23	    end
    24	  end
    25	end
